# Padrão de formatação do CardDex (o VS Code e outros editores seguem isto ao digitar).
# No VS Code, instale a extensão "EditorConfig for VS Code" para valer em todos os arquivos.
# Para formatar tudo de uma vez: python scripts/formatar_codigo.py
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,html,json,yml,webmanifest}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
